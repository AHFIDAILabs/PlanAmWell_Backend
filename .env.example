# Firebase service account credential (JSON), used for raw FCM data messages
# that wake incoming-call ringing when the recipient's app is backgrounded or
# killed. Download from Firebase Console → Project Settings → Service Accounts
# → Generate new private key, then paste the ENTIRE file contents as a single-
# line JSON string (no need to escape it further — it's already valid JSON).
# Optional: raw FCM ringing is simply skipped (Expo push still sends) if unset.
FIREBASE_SERVICE_ACCOUNT=

# Comma-separated egress IP(s) of the web app's Next.js server (the BFF that
# proxies browser traffic to this API). Lets Express correctly attribute
# rate-limited requests to the real website visitor instead of bucketing all
# web traffic behind the Next.js server's own address — set this once the
# web app is deployed and its outbound IP(s) are known. Safe to leave unset
# in the meantime (mobile's direct-to-Render traffic is unaffected either way).
# Example: TRUSTED_PROXY_IPS=76.76.21.21,76.76.21.22
TRUSTED_PROXY_IPS=

# Comma-separated browser origins allowed to call this API with credentials
# (CORS) — mobile apps send no Origin header and are always allowed
# regardless. Left empty, ALL origins are allowed (dev-permissive default).
# This same list also gates the optional `redirectUrl` a client can pass to
# POST /checkout/confirm (see checkoutController.ts's resolveRedirectUrl) —
# if you tighten this list, make sure the web app's real deployed origin is
# included, or that override will silently fall back to the mobile-only
# payment-redirect page instead of the one the web app requested.
# Example: ALLOWED_ORIGINS=https://planamwell.com,https://app.planamwell.com
ALLOWED_ORIGINS=

# Email — Microsoft Graph app-only auth (requires Mail.Send application permission, admin-consented)
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_SENDER_EMAIL=
SUPPORT_EMAIL=